{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ether Manager",
  "version": "0.1.0",
  "identifier": "com.ethermanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ether Manager",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RjdDQzk5NzBDNDQ1MEMKUldRTVJjUndtY3ozWjE4RThHNmZ1RG1ZaGs3UHp4RjRHeFR3VUxCcStKRUU4NDgzc2YrUHNsTzAK",
      "endpoints": [
        "https://github.com/RynxPro/Ether-Manager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
